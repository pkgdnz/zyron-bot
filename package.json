{
  "name": "zyron-bot",
  "version": "1.0.0",
  "description": "Base WhatsApp multi-device bot powered by Zapo JS.",
  "type": "module",
  "main": "main.js",
  "license": "MIT",
  "author": "dnz",
  "engines": {
    "node": ">=20.9.0"
  },
