    "better-sqlite3": "latest",
    "dotenv": "latest",
    "pino": "latest",
    "pino-pretty": "latest",
    "qrcode-terminal": "latest",
    "ws": "latest",
    "zapo-js": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "eslint": "latest",
    "vitest": "latest"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "zapo-js": true
  }
